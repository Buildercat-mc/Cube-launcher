const javaByVersion = {"26.1":"Java 25","1.21.11":"Java 21","1.21.10":"Java 21","1.21.9":"Java 21","1.21.8":"Java 21","1.21.7":"Java 21","1.21.6":"Java 21","1.21.5":"Java 21","1.21.4":"Java 21","1.21.3":"Java 21","1.21.2":"Java 21","1.21.1":"Java 21","1.20.6":"Java 21","1.20.4":"Java 17","1.20.1":"Java 17","1.19.4":"Java 17","1.18.2":"Java 17","1.17.1":"Java 16","1.16.5":"Java 8","1.12.2":"Java 8","1.8.9":"Java 8","1.7.10":"Java 8"};
const mods = [{id:"sodium",name:"Sodium",category:"Оптимизация",icon:"⚡",desc:"Улучшение производительности.",version:"1.21.x"},{id:"fabric-api",name:"Fabric API",category:"Библиотека",icon:"🧩",desc:"Базовая библиотека модов.",version:"1.21.x"}];
let friends = [{name:"BlockFox",status:"В сети",initial:"B"}];
const installed = new Set();

function toast(msg) {
    const t = document.getElementById("toast");
    t.textContent = msg;
    t.classList.add("show");
    clearTimeout(window._toastTimer);
    window._toastTimer = setTimeout(() => t.classList.remove("show"), 2400);
}

function go(page) {
    document.querySelectorAll(".page").forEach(p => p.classList.toggle("active", p.id === "page-" + page));
    document.querySelectorAll("[data-page]").forEach(b => b.classList.toggle("active", b.dataset.page === page));
    document.getElementById("page-title").textContent = titles[page] || "Лаунчер";
    window.scrollTo({top: 0, be