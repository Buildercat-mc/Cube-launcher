<title>Cube Launcher — Java Edition & Customization</title>
<style>
:root{--bg:#0b100d;--panel:#141d16;--panel2:#1a261c;--line:#2b3b2e;--green:#70e879;--green2:#36b84d;--text:#f0f6ef;--muted:#9aa99b;--danger:#ff7777;--accent:#00ffcc}
*{box-sizing:border-box}body{margin:0;background:radial-gradient(ellipse at 80% -20%,#25472b 0,transparent 45%),var(--bg);color:var(--text);font:15px/1.45 system-ui,-apple-system,Segoe UI,Roboto,Arial,sans-serif;min-height:100vh}
button,input,select,textarea{font:inherit}button{cursor:pointer}
.app{max-width:1100px;margin:auto;min-height:100vh;display:grid;grid-template-columns:230px 1fr}
.sidebar{background:#0e150fdd;border-right:1px solid var(--line);padding:22px 14px;display:flex;flex-direction:column;gap:24px}
.brand{display:flex;align-items:center;gap:11px;padding:0 8px}.logo{width:43px;height:43px;display:grid;place-items:center;border-radius:12px;background:linear-gradient(145deg,#9aff8b,#248c37);color:#09200d;font-weight:1000;font-size:22px;box-shadow:0 0 28px #51d45a24}.brand strong{display:block;font-size:17px;letter-spacing:.4px}.brand small{color:var(--muted);font-size:11px;letter-spacing:1.6px}
.nav{display:grid;gap:6px}.nav button{border:1px solid transparent;color:#aebcaf;background:transparent;text-align:left;padding:12px 13px;border-radius:11px;display:flex;align-items:center;gap:12px}.nav button .ico{width:22px;text-align:center;font-size:17px}.nav button.active{background:#213a25;color:var(--green);border-color:#355b39}.nav button:hover{background:#1b2b1d;color:white}
.side-bottom{margin-top:auto;border:1px solid var(--line);background:#131c15;border-radius:13px;padding:13px;color:var(--muted);font-size:12px}.status{display:flex;align-items:center;gap:7px;color:#bcecc0;margin-bottom:5px}.dot{width:7px;height:7px;border-radius:50%;background:var(--green);box-shadow:0 0 10px #70e87988}
main{padding:25px clamp(16px,3vw,34px) 40px;min-width:0}.topbar{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-bottom:25px}.eyebrow{font-size:11px;letter-spacing:2px;color:var(--green);font-weight:800}.topbar h1{font-size:26px;margin:3px 0 0;letter-spacing:-.7px}.profile{display:flex;align-items:center;gap:10px;background:#172119;border:1px solid var(--line);padding:7px 11px;border-radius:12px}.avatar{width:34px;height:34px;border-radius:8px;background:linear-gradient(135deg,#83f17d,#347a41);display:grid;place-items:center;color:#09210e;font-weight:900}.profile small{display:block;color:var(--muted);font-size:11px}
.hero{position:relative;overflow:hidden;border:1px solid #36563a;border-radius:20px;padding:clamp(22px,4vw,38px);background:linear-gradient(105deg,#172b1b 0%,#142018 55%,#102015 100%);min-height:235px;display:flex;align-items:center;margin-bottom:18px}
.hero:before{content:"";position:absolute;width:250px;height:250px;right:5%;top:-35px;opacity:.24;background:linear-gradient(135deg,#9aff8b,#227d35);clip-path:polygon(25% 6%,75% 6%,100% 50%,75% 94%,25% 94%,0 50%);filter:drop-shadow(0 0 24px #70e879)}
.hero:after{content:"";position:absolute;width:140px;height:140px;right:17%;top:48px;opacity:.18;border:12px solid #9aff8b;transform:rotate(45deg)}
.hero-content{position:relative;z-index:1;max-width:520px}.hero h2{font-size:clamp(27px,4vw,42px);line-height:1.05;margin:10px 0 12px;letter-spacing:-1.2px}.hero p{color:#b5c7b7;max-width:440px;margin:0 0 21px}.tag{display:inline-flex;align-items:center;gap:7px;background:#2a492d;color:#b8ffbd;border:1px solid #3f6b43;border-radius:7px;padding:5px 9px;font-size:11px;font-weight:800;letter-spacing:1px}
.actions{display:flex;gap:10px;flex-wrap:wrap}.btn{border:1px solid var(--line);border-radius:10px;padding:11px 15px;color:var(--text);background:#1b281d;font-weight:750}.btn.primary{background:var(--green);border-color:var(--green);color:#09200d;box-shadow:0 5px 20px #70e87920}.btn.primary:hover{background:#8cf793}.btn:hover{filter:brightness(1.12)}.btn:disabled{opacity:.45;cursor:not-allowed}
.grid{display:grid;grid-template-columns:1.15fr .85fr;gap:16px}.panel{background:linear-gradient(145deg,#151f17,#111812);border:1px solid var(--line);border-radius:16px;padding:18px;min-width:0}.panel-head{display:flex;justify-content:space-between;align-items:center;gap:10px;margin-bottom:15px}.panel h3{margin:0;font-size:15px}.muted{color:var(--muted);font-size:12px}.version-row{display:flex;align-items:center;gap:12px}.cube-icon{width:46px;height:46px;border-radius:12px;background:#243a27;display:grid;place-items:center;font-size:23px;transition:all 0.3s}.version-row strong{display:block}.version-row small{color:var(--muted)}.version-select{margin-top:15px;width:100%;background:#0d140f;border:1px solid #344837;color:white;padding:12px;border-radius:9px;outline:none}.progress-wrap{margin-top:15px}.progress-label{display:flex;justify-content:space-between;color:var(--muted);font-size:12px;margin-bottom:7px}.progress{height:6px;border-radius:9px;background:#273329;overflow:hidden}.progress span{display:block;width:0;height:100%;background:var(--green);transition:width .35s}
.stat-row{display:grid;grid-template-columns:repeat(3,1fr);gap:10px}.stat{background:#101711;border:1px solid #253329;border-radius:12px;padding:13px}.stat strong{font-size:22px;display:block}.stat small{color:var(--muted);font-size:11px}
.quick-list{display:grid;gap:10px}.quick{display:flex;align-items:center;gap:11px;padding:10px;background:#101711;border:1px solid #26352a;border-radius:11px}.quick .qicon{width:37px;height:37px;display:grid;place-items:center;background:#203323;border-radius:9px;font-size:18px}.quick strong{font-size:13px;display:block}.quick small{font-size:11px;color:var(--muted)}
.page{display:none}.page.active{display:block}.page-intro{margin:-13px 0 18px;color:var(--muted);font-size:13px}.cards{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}.item{background:#141d16;border:1px solid var(--line);border-radius:14px;padding:15px;min-width:0}.item-top{display:flex;align-items:center;gap:11px;margin-bottom:10px}.item-icon{width:43px;height:43px;border-radius:11px;background:#243a27;display:grid;place-items:center;font-size:21px;flex-shrink:0}.item strong{display:block}.item small{color:var(--muted)}.item p{color:#b4c0b5;font-size:12px;min-height:35px}.item .btn{width:100%;padding:9px;font-size:12px}.section-bar{display:flex;gap:10px;align-items:center;margin-bottom:15px;flex-wrap:wrap}.search{flex:1;min-width:170px;background:#0d140f;border:1px solid var(--line);color:white;border-radius:9px;padding:11px 12px;outline:none}.empty{padding:35px 15px;text-align:center;color:var(--muted);border:1px dashed #354537;border-radius:13px}.empty b{display:block;color:var(--text);margin-bottom:5px}

/* Новые стили: Скины */
.skins-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(140px, 1fr)); gap: 15px; margin-top: 15px; }
.skin-card { background: rgba(255, 255, 255, 0.03); border: 2px solid var(--line); border-radius: 12px; padding: 15px; text-align: center; cursor: pointer; transition: all 0.3s ease; }
.skin-card:hover { border-color: var(--green); transform: translateY(-3px); }
.skin-card.selected { border-color: var(--green); background: rgba(112, 232, 121, 0.1); box-shadow: 0 0 15px rgba(112, 232, 121, 0.2); }
.skin-preview-box { width: 50px; height: 50px; margin: 0 auto 10px; border-radius: 10px; }

/* Новые стили: Среда Java */
.java-container { display: flex; flex-direction: column; gap: 12px; margin-top: 15px; }
.java-editor { width: 100%; height: 160px; background: #0f1410; color: #70e879; font-family: 'Courier New', Courier, monospace; padding: 12px; border: 1px solid var(--line); border-radius: 9px; resize: vertical; font-size: 13px; outline: none; }
.java-console { background: #070a08; color: #affeb3; font-family: 'Courier New', Courier, monospace; padding: 12px; border: 1px solid #1f2e22; border-radius: 9px; height: 110px; overflow-y: auto; font-size: 12px; white-space: pre-wrap; }

.toast{position:fixed;bottom:20px;left:50%;transform:translate(-50%,20px);opacity:0;pointer-events:none;background:#e8ffeb;color:#102114;border-radius:10px;padding:11px 16px;font-weight:750;box-shadow:0 8px 35px #0008;transition:.25s;z-index:10;max-width:calc(100vw - 24px);text-align:center}.toast.show{opacity:1;transform:translate(-50%,0)}
.mobile-nav{display:none}
footer{margin-top:20px;color:#68796a;font-size:11px;text-align:center}
@media(max-width:760px){.app{display:block;padding-bottom:76px}.sidebar{display:none}main{padding:18px 14px 28px}.topbar{margin-bottom:17px}.topbar h1{font-size:22px}.profile .profile-name{display:none}.hero{min-height:255px;padding:23px}.hero:before{right:-65px;top:10px;width:180px;height:180px}.hero:after{right:2%;top:82px;width:90px;height:90px}.hero-content{max-width:88%}.hero p{font-size:13px}.grid{grid-template-columns:1fr}.cards{grid-template-columns:1fr}.stat-row{gap:7px}.stat{padding:10px}.stat strong{font-size:19px}.mobile-nav{position:fixed;z-index:5;bottom:0;left:0;right:0;display:flex;overflow-x:auto;justify-content:space-around;background:#0c130eee;border-top:1px solid var(--line);padding:7px 5px calc(7px + env(safe-area-inset-bottom));backdrop-filter:blur(14px)}.mobile-nav button{border:0;background:transparent;color:#94a396;font-size:10px;padding:5px 9px;min-width:62px;display:grid;justify-items:center;gap:3px;flex:1}.mobile-nav button span{font-size:18px}.mobile-nav button.active{color:var(--green)}.page-intro{margin-top:-10px}}
</style>
</head>
